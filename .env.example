# Copy to .env (or export) - every knob the server reads.
LL_DELAY_SCALE=0.1          # wall seconds you wait per second of real light time (1.0 = True Delay)
LL_JUDGE=0                  # 1 = scripted 8-minute demo mode
LL_SCENARIO=meridian_2020
LL_PORT=8765
LL_OFFLINE=0                # 1 = never touch the network (cached data only)
LL_EPHEMERIS=auto           # auto | spice | kepler
NASA_API_KEY=DEMO_KEY       # api.nasa.gov key for DONKI
# local LLMs (any OpenAI-compatible server; Ollama shown)
LL_TERN_URL=http://127.0.0.1:11434/v1
LL_TERN_MODEL=qwen3:4b      # verify the exact tag with `ollama list`; fine-tuned: tern-capcom
LL_FIDO_URL=http://127.0.0.1:11434/v1
LL_FIDO_MODEL=qwen3:8b
LL_LLM=1
# voice
LL_WHISPER_BIN=whisper-cli
LL_WHISPER_MODEL=data/models/ggml-base.en.bin
LL_PIPER_BIN=piper
LL_PIPER_VOICE_TERN=data/models/piper/tern.onnx
# rooms and public hosting (see deploy/README.md)
LL_PUBLIC=0                 # 1 = public-link preset: LLMs off unless LL_LLM is set, reset needs the token
LL_HOST=0.0.0.0             # 127.0.0.1 behind a Cloudflare tunnel
LL_MAX_ROOMS=8              # missions alive at once, including MAIN
LL_ROOM_IDLE_MIN=30         # minutes an empty room survives
LL_ROOMS_PER_IP_HOUR=10     # new missions per visitor per hour
LL_ADMIN_TOKEN=             # header X-Admin-Token for /api/admin/reset; empty = localhost only
LL_VOICE_MAX_BYTES=2097152  # largest voice clip
LL_VOICE_MAX_CLIPS=50       # clips kept per room
# Story moments (each defaults to on; 0 turns it off).
LL_LAUNCH_FX=1
LL_REALITY=1
LL_RIGHT_NOW=1
